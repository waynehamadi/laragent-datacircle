{
  "name": "datacircle/laragent-tools",
  "description": "Find the best GTM APIs. Four LarAgent tools call Datacircle's public API. You need no API key.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://datacircle.dev",
  "keywords": [
    "laravel",
    "laragent",
    "ai-agents",
    "agents",
    "tools",
    "function-calling",
    "api",
    "gtm",
    "datacircle"
  ],
  "authors": [
    {
      "name": "Wayne Hamadi",
      "email": "wayne@datacircle.dev",
      "homepage": "https://datacircle.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/waynehamadi/laragent-datacircle/issues",
    "source": "https://github.com/waynehamadi/laragent-datacircle",
    "docs": "https://datacircle.dev/api"
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "maestroerror/laragent": "^1.0",
    "guzzlehttp/guzzle": "^7.9 || ^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Datacircle\\LarAgent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Datacircle\\LarAgent\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
